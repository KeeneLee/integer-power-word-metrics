import Mathlib.Data.Int.Basic
import Mathlib.Algebra.Ring.Int.Defs
import Mathlib.Data.Nat.Find
import Mathlib.Data.Finsupp.Basic
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Algebra.Order.BigOperators.Group.Finset
import Lean.Elab.Tactic.Omega

/-!
# The integer metric generated by all signed powers

`wordLength a z` is the least number of signed powers of `a` summing to `z`.
The representation predicate is defined inductively and no metric axioms
are assumed. The use of `Nat.find` is noncomputable only because the
representation predicate is given its classical decidability instance.
-/

namespace Nathanson

/-- One allowed letter in a signed-power word. -/
def PowerStep (a : ℕ) (z : ℤ) : Prop :=
  ∃ k : ℕ, z = (a : ℤ) ^ k ∨ z = -((a : ℤ) ^ k)

namespace PowerStep

theorem pos (a k : ℕ) : PowerStep a ((a : ℤ) ^ k) := ⟨k, Or.inl rfl⟩

theorem neg {a : ℕ} {z : ℤ} (h : PowerStep a z) : PowerStep a (-z) := by
  obtain ⟨k, hk | hk⟩ := h
  · exact ⟨k, Or.inr (by simp [hk])⟩
  · exact ⟨k, Or.inl (by simp [hk])⟩

theorem one (a : ℕ) : PowerStep a 1 := by
  simpa using pos a 0

end PowerStep

/-- `WordBound a N z` means that `z` has an actual word of exactly `N`
signed-power letters. The word need not be shortest. -/
inductive WordBound (a : ℕ) : ℕ → ℤ → Prop
  | zero : WordBound a 0 0
  | step {N : ℕ} {z g : ℤ} :
      WordBound a N z → PowerStep a g → WordBound a (N + 1) (z + g)

namespace WordBound

theorem neg {a N : ℕ} {z : ℤ} (h : WordBound a N z) : WordBound a N (-z) := by
  induction h with
  | zero => simpa using (WordBound.zero (a := a))
  | @step N z g h hg ih =>
      simpa [neg_add, add_comm] using WordBound.step ih hg.neg

theorem add {a N M : ℕ} {z w : ℤ} (h : WordBound a N z)
    (h' : WordBound a M w) : WordBound a (N + M) (z + w) := by
  induction h' with
  | zero => simpa using h
  | @step M w g hw hg ih =>
      simpa [Nat.add_assoc, add_assoc] using WordBound.step ih hg

theorem nat_mul {a : ℕ} {g : ℤ} (hg : PowerStep a g) (N : ℕ) :
    WordBound a N ((N : ℤ) * g) := by
  induction N with
  | zero => simpa using (WordBound.zero (a := a))
  | succ N ih =>
      simpa [Nat.cast_add, add_mul] using WordBound.step ih hg

theorem int_mul {a : ℕ} {g : ℤ} (hg : PowerStep a g) (c : ℤ) :
    WordBound a c.natAbs (c * g) := by
  cases c with
  | ofNat N => simpa using nat_mul hg N
  | negSucc N =>
      change WordBound a (N + 1) (Int.negSucc N * g)
      rw [Int.negSucc_eq]
      simpa only [Nat.cast_add, Nat.cast_one, neg_mul] using
        (nat_mul hg (N + 1)).neg

theorem exists_length (a : ℕ) (z : ℤ) : ∃ N, WordBound a N z := by
  exact ⟨z.natAbs, by simpa using int_mul (PowerStep.one a) z⟩

theorem zero_length {a : ℕ} {z : ℤ} (h : WordBound a 0 z) : z = 0 := by
  cases h
  rfl

end WordBound

/-- Actual signed-power word length, defined as the minimum over words. -/
noncomputable def wordLength (a : ℕ) (z : ℤ) : ℕ := by
  classical
  exact Nat.find (WordBound.exists_length a z)

theorem wordLength_spec (a : ℕ) (z : ℤ) : WordBound a (wordLength a z) z := by
  classical
  exact Nat.find_spec (WordBound.exists_length a z)

theorem wordLength_le {a N : ℕ} {z : ℤ} (h : WordBound a N z) :
    wordLength a z ≤ N := by
  classical
  exact Nat.find_min' (WordBound.exists_length a z) h

@[simp] theorem wordLength_zero (a : ℕ) : wordLength a 0 = 0 := by
  exact Nat.eq_zero_of_le_zero (wordLength_le WordBound.zero)

@[simp] theorem wordLength_eq_zero {a : ℕ} {z : ℤ} :
    wordLength a z = 0 ↔ z = 0 := by
  constructor
  · intro h
    have hs := wordLength_spec a z
    rw [h] at hs
    exact hs.zero_length
  · rintro rfl
    exact wordLength_zero a

theorem wordLength_neg_le (a : ℕ) (z : ℤ) : wordLength a (-z) ≤ wordLength a z :=
  wordLength_le (wordLength_spec a z).neg

@[simp] theorem wordLength_neg (a : ℕ) (z : ℤ) : wordLength a (-z) = wordLength a z := by
  apply Nat.le_antisymm (wordLength_neg_le a z)
  simpa using wordLength_neg_le a (-z)

theorem wordLength_add_le (a : ℕ) (z w : ℤ) :
    wordLength a (z + w) ≤ wordLength a z + wordLength a w :=
  wordLength_le ((wordLength_spec a z).add (wordLength_spec a w))

theorem wordLength_sub_le (a : ℕ) (z w : ℤ) :
    wordLength a (z - w) ≤ wordLength a z + wordLength a w := by
  simpa [sub_eq_add_neg] using wordLength_add_le a z (-w)

theorem wordLength_step_le {a : ℕ} {g : ℤ} (h : PowerStep a g) :
    wordLength a g ≤ 1 := by
  apply wordLength_le
  simpa using WordBound.step (WordBound.zero (a := a)) h

theorem wordLength_pow_le (a k : ℕ) : wordLength a ((a : ℤ) ^ k) ≤ 1 :=
  wordLength_step_le (PowerStep.pos a k)

theorem wordLength_sub_pow_le (a k t : ℕ) :
    wordLength a ((a : ℤ) ^ k - (a : ℤ) ^ t) ≤ 2 := by
  exact (wordLength_sub_le a _ _).trans
    (Nat.add_le_add (wordLength_pow_le a k) (wordLength_pow_le a t))

theorem wordLength_int_mul_pow_le (a k : ℕ) (c : ℤ) :
    wordLength a (c * (a : ℤ) ^ k) ≤ c.natAbs :=
  wordLength_le (WordBound.int_mul (PowerStep.pos a k) c)

/-- The actual Nathanson distance, with values in the natural numbers. -/
noncomputable def wordDist (a : ℕ) (x y : ℤ) : ℕ := wordLength a (y - x)

@[simp] theorem wordDist_self (a : ℕ) (x : ℤ) : wordDist a x x = 0 := by
  simp [wordDist]

@[simp] theorem wordDist_eq_zero {a : ℕ} {x y : ℤ} : wordDist a x y = 0 ↔ x = y := by
  rw [wordDist, wordLength_eq_zero]
  omega

theorem wordDist_comm (a : ℕ) (x y : ℤ) : wordDist a x y = wordDist a y x := by
  unfold wordDist
  rw [← wordLength_neg a (x - y)]
  congr 1
  omega

theorem wordDist_triangle (a : ℕ) (x y z : ℤ) :
    wordDist a x z ≤ wordDist a x y + wordDist a y z := by
  unfold wordDist
  have h : z - x = (y - x) + (z - y) := by omega
  rw [h]
  exact wordLength_add_le a (y - x) (z - y)

@[simp] theorem wordDist_add_right (a : ℕ) (x y t : ℤ) :
    wordDist a (x + t) (y + t) = wordDist a x y := by
  simp [wordDist]

theorem wordDist_step_le {a : ℕ} (x : ℤ) {g : ℤ} (h : PowerStep a g) :
    wordDist a x (x + g) ≤ 1 := by
  simpa [wordDist] using wordLength_step_le h

open scoped BigOperators

theorem wordLength_sum_le {ι : Type*} (a : ℕ) (s : Finset ι) (v : ι → ℤ) :
    wordLength a (∑ i ∈ s, v i) ≤ ∑ i ∈ s, wordLength a (v i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      simpa [Finset.sum_insert, hi] using
        (wordLength_add_le a (v i) (∑ j ∈ s, v j)).trans (Nat.add_le_add_left ih _)

theorem wordLength_digit_sum_le (a : ℕ) (s : Finset ℕ) (c : ℕ → ℤ) :
    wordLength a (∑ k ∈ s, c k * (a : ℤ) ^ k) ≤ ∑ k ∈ s, (c k).natAbs := by
  apply (wordLength_sum_le a s _).trans
  exact Finset.sum_le_sum fun k hk => wordLength_int_mul_pow_le a k (c k)

theorem wordLength_finsupp_sum_le (a : ℕ) (c : ℕ →₀ ℤ) :
    wordLength a (c.sum fun k z => z * (a : ℤ) ^ k) ≤ c.sum fun _ z => z.natAbs := by
  exact wordLength_digit_sum_le a c.support c

/-- A bound on all generator edges propagates along every actual word. -/
theorem wordBound_image_le {a b C N : ℕ} (f : ℤ → ℤ)
    (hstep : ∀ x g : ℤ, PowerStep a g → wordDist b (f x) (f (x + g)) ≤ C)
    {z : ℤ} (hz : WordBound a N z) (x : ℤ) :
    wordDist b (f x) (f (x + z)) ≤ C * N := by
  induction hz with
  | zero => simp
  | @step N z g hz hg ih =>
      calc
        wordDist b (f x) (f (x + (z + g))) =
            wordDist b (f x) (f ((x + z) + g)) := by rw [add_assoc]
        _ ≤ wordDist b (f x) (f (x + z)) +
            wordDist b (f (x + z)) (f ((x + z) + g)) :=
          wordDist_triangle b _ _ _
        _ ≤ C * N + C := Nat.add_le_add ih (hstep (x + z) g hg)
        _ = C * (N + 1) := by rw [Nat.mul_add, Nat.mul_one]

/-- Generator-edge control implies a global Lipschitz bound for the
actual signed-power distances. -/
theorem wordDist_le_of_step_bound {a b C : ℕ} (f : ℤ → ℤ)
    (hstep : ∀ x g : ℤ, PowerStep a g → wordDist b (f x) (f (x + g)) ≤ C)
    (x y : ℤ) : wordDist b (f x) (f y) ≤ C * wordDist a x y := by
  simpa [wordDist, show x + (y - x) = y by omega] using
    wordBound_image_le f hstep (wordLength_spec a (y - x)) x

/-- It is enough to control the positive generator edges; reverse edges
follow from symmetry. This is the main interface for carry arguments. -/
theorem wordDist_le_of_pow_bound {a b C : ℕ} (f : ℤ → ℤ)
    (hpow : ∀ (x : ℤ) (k : ℕ),
      wordLength b (f (x + (a : ℤ) ^ k) - f x) ≤ C)
    (x y : ℤ) : wordDist b (f x) (f y) ≤ C * wordDist a x y := by
  apply wordDist_le_of_step_bound f _ x y
  intro t g hg
  obtain ⟨k, hk | hk⟩ := hg
  · subst g
    exact hpow t k
  · subst g
    have h := hpow (t - (a : ℤ) ^ k) k
    have heq : t - (a : ℤ) ^ k + (a : ℤ) ^ k = t := by omega
    rw [heq] at h
    rw [wordDist_comm]
    simpa [wordDist, sub_eq_add_neg] using h

/-- A generator comparison gives the corresponding comparison of lengths. -/
theorem wordLength_le_of_step_bound {a b C : ℕ}
    (hstep : ∀ g : ℤ, PowerStep a g → wordLength b g ≤ C) (z : ℤ) :
    wordLength b z ≤ C * wordLength a z := by
  have h := wordDist_le_of_step_bound (a := a) (b := b) (C := C)
    id (by intro x g hg; simpa [wordDist] using hstep g hg) 0 z
  simpa [wordDist] using h

theorem wordLength_le_square (a : ℕ) (z : ℤ) :
    wordLength a z ≤ wordLength (a ^ 2) z := by
  have h : ∀ g : ℤ, PowerStep (a ^ 2) g → wordLength a g ≤ 1 := by
    intro g hg
    obtain ⟨k, hk | hk⟩ := hg
    · subst g
      simpa [Nat.cast_pow, ← pow_mul] using wordLength_pow_le a (2 * k)
    · subst g
      simpa [Nat.cast_pow, ← pow_mul] using wordLength_pow_le a (2 * k)
  simpa using wordLength_le_of_step_bound h z

theorem wordLength_square_pow_le {a : ℕ} (ha : 1 ≤ a) (k : ℕ) :
    wordLength (a ^ 2) ((a : ℤ) ^ k) ≤ a := by
  have hr : k % 2 = 0 ∨ k % 2 = 1 := by omega
  have hk : k = 2 * (k / 2) + k % 2 := by omega
  rcases hr with hr | hr
  · have hp : (a : ℤ) ^ k = ((a ^ 2 : ℕ) : ℤ) ^ (k / 2) := by
      conv_lhs => rw [hk]
      simp [hr, Nat.cast_pow, pow_mul]
    rw [hp]
    exact (wordLength_pow_le (a ^ 2) (k / 2)).trans ha
  · have hp : (a : ℤ) ^ k = (a : ℤ) * ((a ^ 2 : ℕ) : ℤ) ^ (k / 2) := by
      conv_lhs => rw [hk]
      simp [hr, Nat.cast_pow, pow_add, pow_mul, mul_comm]
    rw [hp]
    exact wordLength_int_mul_pow_le (a ^ 2) (k / 2) (a : ℤ)

theorem wordLength_square_le {a : ℕ} (ha : 1 ≤ a) (z : ℤ) :
    wordLength (a ^ 2) z ≤ a * wordLength a z := by
  apply wordLength_le_of_step_bound
  intro g hg
  obtain ⟨k, hk | hk⟩ := hg
  · subst g
    exact wordLength_square_pow_le ha k
  · subst g
    simpa using wordLength_square_pow_le ha k

theorem wordDist_le_square (a : ℕ) (x y : ℤ) :
    wordDist a x y ≤ wordDist (a ^ 2) x y :=
  wordLength_le_square a (y - x)

theorem wordDist_square_le {a : ℕ} (ha : 1 ≤ a) (x y : ℤ) :
    wordDist (a ^ 2) x y ≤ a * wordDist a x y :=
  wordLength_square_le ha (y - x)

end Nathanson

